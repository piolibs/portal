{
    "name": "portal",
    "version": "1.1.0",
    "description": "Lightweight web portal: WiFi setup, dashboard, settings, system info and firmware update with a read-only public port",
    "keywords": "web, portal, wifi, dashboard, ota, settings",
    "repository": {
        "type": "git",
        "url": "https://github.com/piolibs/portal.git"
    },
    "authors": [
        {
            "name": "Dmitry Korobkov",
            "email": "dmitry.korobkov.nn@gmail.com",
            "url": "https://github.com/dk6v",
            "maintainer": true
        }
    ],
    "license": "GPL-3.0",
    "frameworks": "arduino",
    "platforms": [
        "espressif8266"
    ],
    "dependencies": {
        "macros": "https://github.com/piolibs/macros.git",
        "console": "https://github.com/piolibs/console.git",
        "config": "https://github.com/piolibs/config.git"
    },
    "build": {
        "libArchive": false,
        "srcDir": "src",
        "includeDir": "include",
        "flags": [
            "-Iinclude"
        ],
        "srcFilter": [
            "+<**/*.cpp>"
        ]
    },
    "headers": [
        "portal.h"
    ],
    "export": {
        "include": [
            "src/**/*",
            "include/*",
            "examples/**/*",
            "LICENSE",
            "README.md"
        ],
        "exclude": [
            "test/*",
            ".gitignore"
        ]
    },
    "examples": [
        "examples/*/*.cpp"
    ]
}
